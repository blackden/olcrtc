# olcrtc compose env-file template
# Copy to .env (gitignored) and edit. OLCRTC_KEY goes into secrets/olcrtc.key, not here.

# --- Required ---
# Auth provider: jitsi, telemost, wbstream, none
OLCRTC_CARRIER=jitsi

# Tunnel transport: datachannel, vp8channel, seichannel, videochannel
# WB Stream guest flow has no canPublishData — use vp8channel/seichannel there.
OLCRTC_TRANSPORT=datachannel

# Room identifier — for srv this is the room your server publishes to;
# for cnc this must match the server's room.
OLCRTC_ROOM_ID=

# --- Server (srv) — optional outbound SOCKS proxy ---
# OLCRTC_SOCKS_PROXY=
# OLCRTC_SOCKS_PROXY_PORT=1080

# --- Client (cnc) — local SOCKS5 listener ---
OLCRTC_SOCKS_HOST=127.0.0.1
OLCRTC_SOCKS_PORT=8808
# OLCRTC_SOCKS_USER=
# OLCRTC_SOCKS_PASS=

# --- Common ---
OLCRTC_DNS=8.8.8.8:53
OLCRTC_DEBUG=false

# --- videochannel only (ffmpeg required in image) ---
# OLCRTC_VIDEO_W=0
# OLCRTC_VIDEO_H=0
# OLCRTC_VIDEO_FPS=0
# OLCRTC_VIDEO_BITRATE=
# OLCRTC_VIDEO_HW=none
# OLCRTC_VIDEO_CODEC=qrcode
# OLCRTC_VIDEO_QR_SIZE=0
# OLCRTC_VIDEO_QR_RECOVERY=low
# OLCRTC_VIDEO_TILE_MODULE=0
# OLCRTC_VIDEO_TILE_RS=0

# --- vp8channel only ---
# OLCRTC_VP8_FPS=0
# OLCRTC_VP8_BATCH=0

# --- seichannel only ---
# OLCRTC_SEI_FPS=0
# OLCRTC_SEI_BATCH=0
# OLCRTC_SEI_FRAG=0
# OLCRTC_SEI_ACK=0

# --- Override published image ---
# OLCRTC_IMAGE=ghcr.io/blackden/olcrtc:latest
